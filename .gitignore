# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnp/
.pnp.js

# Builds
/server/dist/
/mobile/dist/
build/
*.tsbuildinfo

# Expo / React Native
mobile/.expo/
mobile/android/
mobile/ios/
mobile/web-build/
*.apk
*.aab
*.keystore
!debug.keystore

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Local build/test artifacts
build-apk.log
fetch-gradle.sh
.claude/
**/.claude/
# Scratch files from manual endpoint testing
server/*.png
server/*.jpg

# The published web export is deliberately committed: Render serves it directly.
# Expo writes hashed assets under paths containing both "node_modules" and
# "build" (e.g. @expo/vector-icons/build/vendor/.../Ionicons.ttf), so the
# generic rules above would silently strip every font and icon from the deploy.
# Each excluded parent directory has to be re-included before the files in it.
!server/public/
!server/public/**/node_modules/
!server/public/**/build/
!server/public/**
