{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "//": "Installable APK for testing on a device. This is the one you want.",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://zahiri-api.onrender.com"
      }
    },
    "production": {
      "//": "AAB for the Play Store.",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://zahiri-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
