# ---- Core ----
NODE_ENV=development
PORT=8080
# Comma-separated origins allowed to call the API (mobile app uses none of these)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- MongoDB Atlas (cloud) ----
# Atlas > Connect > Drivers. Keep the database name in the path.
DNS_SERVERS=
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/zahiri?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- AI providers (OpenAI-compatible) ----
# NVIDIA NIM: https://build.nvidia.com  (free tier is rate limited)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# Which provider to try first: nvidia | openrouter
AI_PRIMARY_PROVIDER=nvidia
# Fall back to the other provider when the primary errors or is rate limited
AI_FALLBACK_ENABLED=true
# Client-side guard for NVIDIA free tier (requests per minute)
NVIDIA_RPM_LIMIT=40

# ---- WhatsApp Cloud API (plugin / companion) ----
WHATSAPP_VERIFY_TOKEN=zahiri-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
